# Copy this file to .env and fill in your values
# Get Supabase credentials from: https://supabase.com/dashboard > Project > Settings > API

# Supabase (required for sensor_status updates and logs persistence)
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PayMongo (for QR code payments)
# Get these from: https://dashboard.paymongo.com → API Keys
PAYMONGO_PUBLIC_KEY=your_paymongo_public_key_here
PAYMONGO_SECRET_KEY=your_paymongo_secret_key_here

# MQTT (for ESP32 communication)
# For testing: test.mosquitto.org (public, free)
# For production: self-hosted Mosquitto or cloud broker
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# RESEND Email Service (for alerts)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=alerts@smarth2wo.com
# Comma-separated list of email recipients (supports multiple admins)
ALERT_RECIPIENT_EMAIL=admin@example.com,admin2@example.com

# Alert Cooldown (prevent email spam - in minutes)
EMAIL_COOLDOWN_MINUTES=30

# Server (optional)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True
ENVIRONMENT=development

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:5173
