# Use this Dockerfile when npm install inside Docker fails due to network issues.
# Build the frontend locally first, then this just copies the dist into nginx.
#
# Usage:
#   1. Build locally:  npm run build  (from the frontend/ directory)
#   2. Docker build:   docker-compose -f docker-compose.prod.yml build frontend
#
FROM nginx:alpine
COPY dist /usr/share/nginx/html
# Support React Router by redirecting 404s to index.html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
